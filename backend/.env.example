# =====================================================
# BongoPortus - Shared Backend Configuration Template
# Copy to .env and fill in your values
# =====================================================

# ─── Supabase Configuration ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SECURITY: Service role key — ONLY used by backend Edge Functions.
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Vite-prefixed aliases (auto-read by website via envDir) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Stripe Configuration ────────────────────────────
# Publishable key (safe for frontend)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# SECURITY: Stripe secret key — ONLY used by backend Edge Functions.
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# ─── Google OAuth (Mobile) ───────────────────────────
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# ─── Deep Link Scheme ────────────────────────────────
DEEP_LINK_SCHEME=io.supabase.bongoportus
DEEP_LINK_HOST=login-callback
